{
  "manifest_version": 3,
  "name": "archyve",
  "version": "3.0.0",
  "description": "academic research intelligence layer for the academic web.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ieeexplore.ieee.org/document/*",
        "https://link.springer.com/article/*",
        "https://link.springer.com/chapter/*",
        "https://link.springer.com/referenceworkentry/*",
        "https://www.sciencedirect.com/science/article/pii/*",
        "https://www.jstor.org/stable/*",
        "https://arxiv.org/abs/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "analyze with archyve",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "trigger_archyve": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "analyze paper with archyve"
    }
  }
}