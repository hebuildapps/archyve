{
  "name": "archyve-v2",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/extension",
    "packages/shared"
  ],
  "scripts": {
    "build": "npm run build:shared && npm run build:web",
    "dev": "npm run dev -w apps/web",
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build:shared && npm run build -w apps/web",
    "build:shared": "npm run build -w packages/shared",
    "build:extension": "npm run build -w apps/extension",
    "lint": "npm run lint -ws",
    "test": "npm run test -w apps/web"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
